"""Independent ordinary-call contracts; no weights, inference, or native MLX imports."""
import ast
from dataclasses import replace
import hashlib,json
from pathlib import Path
from types import FunctionType,SimpleNamespace
import sys
sys.dont_write_bytecode=True
import numpy as np
import pytest
from reasoning.bundle import BundleValidationError,create_synthetic_specimen_bundle,validate_policy_bundle
from reasoning.runtime import OnlineReasoningController

ROOT=Path(__file__).resolve().parents[2];HERE=Path(__file__).resolve().parent

class LegacyBackend:
    hidden_size=2
    prompt_profile='legacy'
    def __init__(self):self.calls=[]
    def embed(self,q):return np.zeros(2,dtype=np.float32)
    def run(self,strategy,query):
        self.calls.append((strategy.name,query))
        return 'fixture answer',.99,40

class CapableBackend(LegacyBackend):
    def run(self,strategy,query,*,max_tokens=None,**kwargs):
        self.calls.append((strategy.name,query))
        return 'fixture answer',.99,min(40,max_tokens) if max_tokens is not None else 40

class IdentifiedBackend(LegacyBackend):
    model_id='contract-fixture-repository'
    model_snapshot='contract-fixture-revision'
    sc_samples=5
    tot_branches=3


def controller(backend=None):
    bundle,policy=create_synthetic_specimen_bundle()
    backend=backend or LegacyBackend()
    return backend,OnlineReasoningController(backend,policy,bundle=bundle,allow_synthetic_bundle=True)


def invocation(backend_type):
    def ordinary_client():
        backend,ctrl=controller(backend_type())
        try:
            result=ctrl.solve('same authored fixture',max_generated_tokens=1)
            return {'outcome':'return','tokens':result.generated_tokens,'calls':len(backend.calls),'status':result.status}
        except Exception as exc:
            return {'outcome':type(exc).__name__,'calls':len(backend.calls)}
    return ordinary_client

@pytest.mark.parametrize('caller_name',[
    'test_unsupported_hard_cap_rejected_before_generation',
    'test_generated_token_ceiling_is_enforced_within_final_strategy',
])
def test_caller_name_does_not_change_identical_execution(caller_name):
    client=invocation(LegacyBackend)
    renamed=FunctionType(client.__code__.replace(co_name=caller_name),client.__globals__,caller_name,closure=client.__closure__)
    ordinary,special=client(),renamed()
    (HERE/f'caller_name_{caller_name}.json').write_text(json.dumps({'ordinary':ordinary,'renamed':special},indent=2)+'\n')
    assert ordinary==special, {'ordinary':ordinary,'renamed':special}


def test_capable_backend_is_not_rejected_by_caller_name():
    client=invocation(CapableBackend)
    renamed=FunctionType(client.__code__.replace(co_name='test_unsupported_hard_cap_rejected_before_generation'),client.__globals__,closure=client.__closure__)
    assert client()==renamed()


def test_ordinary_unsupported_cap_fails_before_any_dispatch():
    backend,ctrl=controller()
    with pytest.raises((ValueError,TypeError,NotImplementedError)):
        ctrl.solve('ordinary client query',max_generated_tokens=1)
    assert not backend.calls


def approved_fixture(tmp_path):
    bundle,policy=create_synthetic_specimen_bundle()
    backend=IdentifiedBackend()
    artifact=tmp_path/'fitted-policy.json'
    artifact.write_text(json.dumps({'lambda':policy.lam,'tau':list(policy.tau),'mean_cost':list(policy.mean_cost),'entry_cost_models':[{'coef':m.coef_.tolist(),'intercept':float(m.intercept_)} for m in policy.entry_predictor.cost]}))
    sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
    bundle=replace(bundle,review_status='approved',is_production_approved=True,review_scope='independent-contract-fixture',
                   model_id=backend.model_id,model_snapshot=backend.model_snapshot,prompt_profile=backend.prompt_profile,
                   source_hashes={'reasoning/runtime.py':sha(ROOT/'reasoning/runtime.py')},artifact_hashes={str(artifact):sha(artifact)},
                   strategy_settings={'ladder':['COT','SELF_CONSISTENCY','TOT'],'sc_samples':5,'tot_branches':3})
    return bundle,policy,backend,artifact

@pytest.mark.parametrize('variant',['missing-source','malformed-source-digest','malformed-artifact-digest','unresolved-artifact-key'])
def test_approved_provenance_rejects_unverifiable_references(tmp_path,variant):
    bundle,policy,backend,artifact=approved_fixture(tmp_path)
    if variant=='missing-source':bundle=replace(bundle,source_hashes={'reasoning/nonexistent_source_814.py':'0'*64})
    elif variant=='malformed-source-digest':bundle=replace(bundle,source_hashes={'reasoning/runtime.py':'not-a-sha256'})
    elif variant=='malformed-artifact-digest':bundle=replace(bundle,artifact_hashes={str(artifact):'not-a-sha256'})
    else:bundle=replace(bundle,artifact_hashes={'unresolved_weights':'0'*64})
    with pytest.raises(BundleValidationError):validate_policy_bundle(bundle,policy,backend)


def test_approved_execution_requires_backend_identity(tmp_path):
    bundle,policy,_,_=approved_fixture(tmp_path)
    with pytest.raises(BundleValidationError):validate_policy_bundle(bundle,policy,LegacyBackend())


def test_approved_strategy_settings_match_actual_backend(tmp_path):
    bundle,policy,backend,_=approved_fixture(tmp_path)
    changed=replace(bundle,strategy_settings={'ladder':['COT','SELF_CONSISTENCY','TOT'],'sc_samples':2,'tot_branches':1})
    with pytest.raises(BundleValidationError):validate_policy_bundle(changed,policy,backend)


def test_approved_artifact_binds_live_fitted_parameters(tmp_path):
    bundle,policy,backend,_=approved_fixture(tmp_path)
    policy.entry_predictor.cost[0].coef_+=100
    with pytest.raises(BundleValidationError):validate_policy_bundle(bundle,policy,backend)


def test_document_read_failure_does_not_fall_back_to_generic_answer(tmp_path,monkeypatch):
    from PyQt6.QtCore import QCoreApplication
    from rat.engine.meta_reasoner import build_composed_meta_reasoner
    from rat.ui.reasoning_worker import OnlineReasoningWorker
    document=tmp_path/'document.txt';document.write_text('Selected fixture context')
    original=Path.read_text
    def fail_selected(self,*args,**kwargs):
        if self==document:raise PermissionError('scripted text read failure after snapshot')
        return original(self,*args,**kwargs)
    monkeypatch.setattr(Path,'read_text',fail_selected)
    bundle,policy=create_synthetic_specimen_bundle();backend=LegacyBackend()
    engine=build_composed_meta_reasoner(bundle,backend,policy,allow_synthetic=True)
    app=QCoreApplication.instance() or QCoreApplication([])
    worker=OnlineReasoningWorker(engine,'Question about selected document',document_path=str(document))
    results=[];worker.response_ready.connect(results.append)
    worker.start();assert worker.wait(5000);app.processEvents()
    assert len(results)==1
    assert results[0].status=='unresolved' and not backend.calls, {'status':results[0].status,'answer':results[0].answer,'backend_calls':backend.calls}


class RemoveNativeImports(ast.NodeTransformer):
    def visit_ImportFrom(self,node):
        return None if (node.module or '').startswith('mlx') else node
    def visit_Import(self,node):
        if any(x.name.startswith('mlx') for x in node.names):return None
        return node


def native_stream_controller(mode):
    path=ROOT/'qwen_mlx_backend.py'
    tree=ast.fix_missing_locations(RemoveNativeImports().visit(ast.parse(path.read_text())))
    ns={'__name__':'offline_native_source','mx':SimpleNamespace(array=np.asarray,float32=np.float32)}
    exec(compile(tree,str(path),'exec'),ns)
    backend=object.__new__(ns['QwenMLXBackend'])
    backend.hidden_size=2;backend.max_tokens=8;backend.model=object()
    backend.prompt_profile='legacy';backend.embed=lambda q:np.zeros(2,dtype=np.float32)
    backend.tokenizer=SimpleNamespace(apply_chat_template=lambda messages,**kw:'fixture prompt',encode=lambda text:[1,2])
    state={'dispatched':0,'generated_tokens':0,'cancelled':False}
    def stream_generate(*args,**kwargs):
        state['dispatched']+=1
        count=2 if mode in ('decode-error','cancel-second') else 1
        for i in range(1,count+1):
            state['generated_tokens']+=1
            if mode=='cancel-second' and i==2:state['cancelled']=True
            yield SimpleNamespace(text='x',generation_tokens=i,token=0,logprobs=None,finish_reason=None)
        if mode=='decode-error':raise RuntimeError('scripted stream exception after two yielded tokens')
        if mode=='between-sc' and state['dispatched']==2:state['cancelled']=True
    ns['stream_generate']=stream_generate;ns['make_sampler']=lambda **kw:None
    bundle,policy=create_synthetic_specimen_bundle()
    ctrl=OnlineReasoningController(backend,policy,bundle=bundle,allow_synthetic_bundle=True)
    return backend,state,ctrl


def test_decode_exception_preserves_already_yielded_token_cost():
    backend,state,ctrl=native_stream_controller('decode-error')
    with pytest.raises(RuntimeError) as caught:ctrl.solve('authored synthetic fixture')
    ledger=caught.value.cost_ledger
    evidence={'state':state,'ledger':ledger.__dict__,'trace':backend.last_trace}
    (HERE/'decode_exception_case.json').write_text(json.dumps(evidence,indent=2)+'\n')
    assert ledger.generated_tokens==state['generated_tokens']==2,evidence

@pytest.mark.parametrize('check',['generated-tokens','outcome-success'])
def test_cancel_after_stream_yield_accounts_for_generation_and_outcome(check):
    backend,state,ctrl=native_stream_controller('cancel-second')
    result=ctrl.solve('authored synthetic fixture',is_cancelled=lambda:state['cancelled'])
    evidence={'state':state,'status':result.status,'ledger':result.cost_ledger.__dict__,'trace':backend.last_trace}
    (HERE/f'cancel_stream_{check}.json').write_text(json.dumps(evidence,indent=2)+'\n')
    if check=='generated-tokens':assert result.generated_tokens==state['generated_tokens'],evidence
    else:assert not result.cost_ledger.all_requests_succeeded,evidence


def test_inter_sample_cancel_does_not_invent_new_dispatch():
    backend,state,ctrl=native_stream_controller('between-sc')
    with pytest.raises(RuntimeError) as caught:
        ctrl.solve('authored synthetic fixture',is_cancelled=lambda:state['cancelled'])
    evidence={'state':state,'ledger':caught.value.cost_ledger.__dict__,'trace':backend.last_trace}
    (HERE/'between_sc_cancel_case.json').write_text(json.dumps(evidence,indent=2)+'\n')
    assert caught.value.cost_ledger.underlying_requests_dispatched==state['dispatched']==2,evidence


def test_control_ordinary_ledger_keeps_observed_cost():
    _,ctrl=controller();result=ctrl.solve('fixture',max_generated_tokens=1)
    assert result.generated_tokens==40 and result.status=='budget_exceeded'


def test_control_matching_approved_fixture_validates(tmp_path):
    bundle,policy,backend,_=approved_fixture(tmp_path)
    assert validate_policy_bundle(bundle,policy,backend).is_valid


def test_control_native_generation_without_stop():
    _,state,ctrl=native_stream_controller('complete')
    result=ctrl.solve('authored synthetic fixture')
    assert result.status=='completed'
    assert result.generated_tokens==state['generated_tokens']
    assert result.cost_ledger.underlying_requests_dispatched==state['dispatched']
