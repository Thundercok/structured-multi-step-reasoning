+
+        # Background capsule
+        p.setBrush(QColor("#F8F5EE"))
+        p.setPen(QPen(QColor("#E2D7C7"), 1.5))
+        p.drawRoundedRect(1, 1, 32, 32, 16, 16)
+
+        # Mascot face
+        if self._bust_pm and not self._bust_pm.isNull():
