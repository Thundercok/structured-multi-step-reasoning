+# =============================================================================
+# 11. PROOF ENVELOPE CONTROLS (POSITIVE AND NEGATIVE)
+# =============================================================================
+
+def test_proof_envelope_linkage_positive_and_negative_controls():
+    runtime, history = runtime_fixture(), ConversationHistory()
+
+    # Positive control: calculate 18 * 7 with calculation_execution PASS proof linked to receipt
+    contract = TurnContract(
+        outcomes=[
+            OutcomeSpec("calc", kind=OutcomeKind.REGISTERED_EFFECT, effect_type="calculate",
+                        required_proof_scope="calculation_execution"),
+            OutcomeSpec("ans", kind=OutcomeKind.RESPONSE),
+        ],
+        intent_coverage="model_proposed",
+    )
+    _, resp = run_turn(
+        runtime, history, "Tính 18 * 7",
+        [action("calculate", expression="18 * 7"), answer("126")],
+        contract=contract,
+    )
+    assert resp.reconciliation.declared_scope_completion == "satisfied"
+    assert resp.reconciliation.scoped_quality == "PASS"
+
+    # Negative control: UNKNOWN proof cannot satisfy required proof
+    runtime_neg, hist_neg = runtime_fixture(), ConversationHistory()
+    contract_neg = TurnContract(
+        outcomes=[
+            OutcomeSpec("calc", kind=OutcomeKind.REGISTERED_EFFECT, effect_type="calculate",
+                        required_proof_scope="unknown_scope"),
+        ],
+        intent_coverage="model_proposed",
+    )
+    _, resp_neg = run_turn(
+        runtime_neg, hist_neg, "Tính 18 * 7",
+        [action("calculate", expression="18 * 7"), answer("126")],
+        contract=contract_neg,
+    )
+    assert resp_neg.reconciliation.declared_scope_completion != "satisfied"
+
+
+# =============================================================================
+# 12. TERMINAL NOTE SOURCE AND PROOF CONTROLS
+# =============================================================================
+
+def test_terminal_note_source_and_proof_scope_controls():
+    runtime, history = runtime_fixture(), ConversationHistory()
+    runtime.artifact_store.put(Artifact("original", "sample", payload={"result": "126"}))
+    runtime.artifact_store.put(Artifact("other", "sample", payload={"result": "162"}))
+    original = {"artifact_id": "original", "revision": 1, "field": "result"}
+    other = {"artifact_id": "other", "revision": 1, "field": "result"}
+
+    # Negative control: Note requires source_calculation_note proof scope, but has none
+    contract_proof = TurnContract(
+        outcomes=[
+            OutcomeSpec("save", kind=OutcomeKind.REGISTERED_EFFECT, effect_type="record_work_note",
+                        source_ref=original, required_proof_scope="source_calculation_note")
+        ],
+        intent_coverage="model_proposed",
+    )
+    _, resp_proof = run_turn(
+        runtime, history, "Ghi 126",
+        [action("record_work_note", text="126", source_result=original), answer("Đã ghi")],
+        contract=contract_proof,
+    )
+    assert resp_proof.reconciliation.declared_scope_completion != "satisfied"
+
+    # Negative control: Terminal note was modified to a different source in subsequent step
+    runtime2, history2 = runtime_fixture(), ConversationHistory()
+    runtime2.artifact_store.put(Artifact("original", "sample", payload={"result": "126"}))
+    runtime2.artifact_store.put(Artifact("other", "sample", payload={"result": "162"}))
+    contract_term = TurnContract(
+        outcomes=[
+            OutcomeSpec("save", kind=OutcomeKind.REGISTERED_EFFECT, effect_type="record_work_note", source_ref=original)
+        ],
+        intent_coverage="model_proposed",
+    )
+    def update_to_other():
+        note = runtime2.notebook.snapshot()[0]
+        return action("record_work_note", text="162", source_result=other,
+                      replace_note_id=note["id"], revision=note["revision"])
+    _, resp_term = run_turn(
+        runtime2, history2, "Ghi rồi đổi",
+        [action("record_work_note", text="126", source_result=original), update_to_other, answer("Đã đổi")],
+        contract=contract_term,
+    )
+    assert resp_term.reconciliation.declared_scope_completion != "satisfied"
+
