+# =============================================================================
+# 13. DAG ORDERING, CYCLE REJECTION, AND NESTED FREEZING CONTROLS
+# =============================================================================
+
+def test_dag_ordering_and_cycle_controls():
+    # Invariant to declaration order
+    for order in ("producer_first", "consumer_first"):
+        rt, hist = runtime_fixture(), ConversationHistory()
+        producer = OutcomeSpec("calc", kind=OutcomeKind.REGISTERED_EFFECT, effect_type="calculate")
+        consumer = OutcomeSpec("save", kind=OutcomeKind.REGISTERED_EFFECT, effect_type="record_work_note",
+                               source_ref={"producer_outcome_id": "calc"}, dependency_ids=["calc"])
+        outcomes = [producer, consumer] if order == "producer_first" else [consumer, producer]
+        contract = TurnContract(outcomes=outcomes, intent_coverage="model_proposed")
+
+        def save_result():
+            res = rt.artifact_store.list("calculation")[-1]
+            return action("record_work_note", text="126", source_result={
+                "artifact_id": res.id, "revision": res.revision, "field": "result"})
+
+        _, resp = run_turn(
+            rt, hist, "Tính và ghi",
+            [action("calculate", expression="18 * 7"), save_result, answer("Xong 126")],
+            contract=contract,
+        )
+        assert resp.reconciliation.declared_scope_completion == "satisfied"
+
+    # Cycle rejection
+    cyclic_contract = TurnContract(
+        outcomes=[
+            OutcomeSpec("a", kind=OutcomeKind.REGISTERED_EFFECT, effect_type="read_a", dependency_ids=["b"]),
+            OutcomeSpec("b", kind=OutcomeKind.REGISTERED_EFFECT, effect_type="read_b", dependency_ids=["a"]),
+        ]
+    )
+    assert not cyclic_contract.is_valid
+    assert "dependency_cycle" in cyclic_contract.validation_errors
+    journal = ExecutionJournal("c", "t", "e", 1)
+    rec = reconcile_turn(cyclic_contract, journal, lifecycle="completed", final_answer="done")
+    assert rec.declared_scope_completion != "satisfied"
+
+    # Nested freezing
+    freeze_contract = TurnContract(outcomes=[
+        OutcomeSpec("s", kind=OutcomeKind.REGISTERED_EFFECT, effect_type="record_work_note",
+                    source_ref={"artifact_id": "art-1", "revision": 1},
+                    target_ref={"note_id": "note-1", "expected_revision": 1},
+                    dependency_ids=["p"]),
+        OutcomeSpec("p", kind=OutcomeKind.REGISTERED_EFFECT, effect_type="calculate"),
+    ])
+    freeze_contract.freeze()
+    with pytest.raises((RuntimeError, AttributeError, TypeError)):
+        freeze_contract.outcomes[0].source_ref.clear()
+    with pytest.raises((RuntimeError, AttributeError, TypeError)):
+        freeze_contract.outcomes[0].target_ref.clear()
+    with pytest.raises((RuntimeError, AttributeError, TypeError)):
+        freeze_contract.outcomes[0].dependency_ids.clear()
+
