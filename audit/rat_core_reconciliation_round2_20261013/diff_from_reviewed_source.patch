+def _match_calculate(
+    outcome: OutcomeSpec,
+    receipts: List[ReceiptEnvelope],
+    used_ids: Set[str],
+    producer_artifacts: Dict[str, Dict[str, Any]],
+    verif_reports: List[Dict[str, Any]],
+) -> Tuple[Optional[ReceiptEnvelope], Optional[str]]:
+    matched_rcpt = None
+    for r in receipts:
+        if r.receipt_id in used_ids:
+            continue
+        if r.operation_name == "calculate" and r.committed and r.status == "committed":
+            op_args = r.operation_args or {}
+            expr = op_args.get("expression")
+
+            # Expression binding check if description specifies a mathematical expression
+            if outcome.description and expr:
+                import re
+                desc_clean = re.sub(r"\s+", "", outcome.description)
+                expr_clean = re.sub(r"\s+", "", str(expr))
+                if any(op in outcome.description for op in ("*", "+", "-", "/")):
+                    if expr_clean not in desc_clean and desc_clean not in expr_clean:
+                        continue
+
+            # Proof lineage check: must belong to THIS receipt
+            if outcome.required_proof_scope:
+                receipt_reports = [
+                    rep for rep in verif_reports
+                    if rep.get("operation_receipt_id") == r.receipt_id
+                    or r.receipt_id in (rep.get("parent_receipt_ids") or [])
+                ]
+                if not receipt_reports and r.artifact_refs:
+                    art_ids = {a.get("id") or a.get("artifact_id") for a in r.artifact_refs}
+                    receipt_reports = [
+                        rep for rep in verif_reports
+                        if any(e in art_ids for e in rep.get("evidence_ids", []))
+                    ]
+                matching_scope = [
+                    rep for rep in receipt_reports
+                    if rep.get("scope") == outcome.required_proof_scope
+                ]
+                if not matching_scope or any(rep.get("status") != "PASS" for rep in matching_scope):
+                    continue
+
+            matched_rcpt = r
+            break
+
+    if matched_rcpt is not None:
+        used_ids.add(matched_rcpt.receipt_id)
+        if matched_rcpt.artifact_refs:
+            producer_artifacts[outcome.outcome_id] = matched_rcpt.artifact_refs[0]
+        return matched_rcpt, None
+    return None, "omitted_action"
+
+
+def _match_note(
+    outcome: OutcomeSpec,
+    receipts: List[ReceiptEnvelope],
+    used_ids: Set[str],
+    producer_artifacts: Dict[str, Dict[str, Any]],
+    notebook_snapshot: Optional[List[Dict[str, Any]]],
+    journal: ExecutionJournal,
+) -> Tuple[Optional[ReceiptEnvelope], Optional[str]]:
+    note_receipts = [
+        r for r in receipts
+        if r.issuer == "notebook" and r.committed and r.note_event and r.receipt_id not in used_ids
+    ]
+    if not note_receipts:
+        return None, "omitted_action"
+
+    unmet_reason = "omitted_action"
+    matched_rcpt = None
+
+    for r in note_receipts:
+        evt = r.note_event or {}
+        snap = evt.get("snapshot") or {}
+        source_ref = snap.get("source_ref") or {}
+        note_id = evt.get("note_id")
+
+        # 1. Terminal note verification
+        terminal_note = None
+        if notebook_snapshot is not None:
+            for n in notebook_snapshot:
+                if n.get("id") == note_id:
+                    terminal_note = n
+                    break
+        else:
+            all_evts = [
+                rec.note_event for rec in journal.receipts
+                if rec.issuer == "notebook" and rec.note_event and rec.note_event.get("note_id") == note_id
+            ]
+            if all_evts:
+                terminal_note = all_evts[-1].get("snapshot")
+
+        if terminal_note is None or terminal_note.get("status") == "removed":
+            unmet_reason = "note_removed"
+            continue
+
+        # Proposal check on terminal note
+        if not outcome.allow_proposal:
+            if not terminal_note.get("confirmed", False) or terminal_note.get("status") == "proposed":
+                unmet_reason = "unconfirmed_proposal"
+                continue
+
+        # 2. Source linkage check
+        if outcome.source_ref:
+            prod_id = outcome.source_ref.get("producer_outcome_id")
+            if prod_id:
+                expected_prod = producer_artifacts.get(prod_id)
+                if not expected_prod:
+                    unmet_reason = "wrong_source_consumer"
+                    continue
+                expected_art_id = expected_prod.get("artifact_id") or expected_prod.get("id")
+                expected_rev = expected_prod.get("revision") or expected_prod.get("artifact_revision")
+                consumer_art_id = source_ref.get("artifact_id") or source_ref.get("id")
+                consumer_rev = source_ref.get("artifact_revision") or source_ref.get("revision")
+                if consumer_art_id != expected_art_id or consumer_rev != expected_rev:
+                    unmet_reason = "wrong_source_consumer"
+                    continue
+
+            if "artifact_id" in outcome.source_ref:
+                consumer_art_id = source_ref.get("artifact_id") or source_ref.get("id")
+                if consumer_art_id != outcome.source_ref["artifact_id"]:
+                    unmet_reason = "wrong_source_consumer"
+                    continue
+            if "revision" in outcome.source_ref:
+                consumer_rev = source_ref.get("artifact_revision") or source_ref.get("revision")
+                if consumer_rev != outcome.source_ref["revision"]:
+                    unmet_reason = "wrong_source_consumer"
+                    continue
+            if "field" in outcome.source_ref:
+                if source_ref.get("field") != outcome.source_ref["field"]:
+                    unmet_reason = "wrong_source_consumer"
+                    continue
+
+        # 3. Target note check
+        if outcome.target_ref:
+            target_id = outcome.target_ref.get("note_id")
+            if target_id and note_id != target_id:
+                unmet_reason = "target_mismatch"
+                continue
+            expected_rev = outcome.target_ref.get("expected_revision")
+            if expected_rev is not None:
+                before_rev = evt.get("before_revision")
+                if before_rev is not None and before_rev != expected_rev:
+                    unmet_reason = "target_revision_mismatch"
+                    continue
+
+        matched_rcpt = r
+        break
+
+    if matched_rcpt is not None:
+        used_ids.add(matched_rcpt.receipt_id)
+        return matched_rcpt, None
+    return None, unmet_reason
+
