"""Independent contract probes. Expected failures expose submitted runtime gaps.
All backends are local doubles; no model imports or inference.
"""
from dataclasses import replace
from pathlib import Path
import time
import numpy as np
import pytest
from PyQt6.QtCore import QCoreApplication
from reasoning.bundle import BundleValidationError,create_synthetic_specimen_bundle,validate_policy_bundle
from reasoning.runtime import OnlineReasoningController
from rat.engine.meta_reasoner import build_composed_meta_reasoner
from rat.ui.reasoning_worker import OnlineReasoningWorker

class Backend:
    hidden_size=2
    model_id='different-model'
    model_snapshot='different-snapshot'
    prompt_profile='legacy'
    supported=frozenset()
    def __init__(self, callback=None):
        self.calls=[]
        self.callback=callback
        self.last_trace={'generations':[]}
        self.cancel_hook_received=False
    def embed(self,query):
        return np.zeros(2,dtype=np.float32)
    def run(self,strategy,query,*,should_cancel=None,deadline_monotonic=None):
        self.calls.append(strategy.name)
        self.cancel_hook_received=callable(should_cancel)
        if self.callback:
            self.callback()
        self.last_trace={'generations':[{'completion_tokens':40}]}
        return 'fixture answer',0.99,40

def make(backend=None):
    bundle,policy=create_synthetic_specimen_bundle()
    backend=backend or Backend()
    controller=OnlineReasoningController(backend,policy,bundle=bundle,allow_synthetic_bundle=True)
    return bundle,policy,backend,controller

def worker_result(worker):
    app=QCoreApplication.instance() or QCoreApplication([])
    results=[];steps=[]
    worker.response_ready.connect(results.append)
    worker.step_completed.connect(steps.append)
    worker.start()
    assert worker.wait(5000)
    app.processEvents()
    assert len(results)==1
    return results[0],steps

@pytest.mark.parametrize('field',['max_strategy_invocations','max_underlying_requests','max_generated_tokens'])
def test_zero_per_call_budget_dispatches_nothing(field):
    _,_,backend,controller=make()
    result=controller.solve('offline query',**{field:0})
    assert backend.calls==[], {'field':field,'calls':backend.calls,'status':result.status}

@pytest.mark.parametrize('field',['max_strategy_invocations','max_underlying_requests','max_generated_tokens'])
def test_zero_override_does_not_restore_positive_default(field):
    bundle,policy,backend,_=make()
    controller=OnlineReasoningController(backend,policy,bundle=bundle,allow_synthetic_bundle=True,**{field:10})
    result=controller.solve('offline query',**{field:0})
    assert backend.calls==[], {'field':field,'calls':backend.calls,'status':result.status}

def test_generated_token_ceiling_is_enforced_within_final_strategy():
    _,_,_,controller=make()
    result=controller.solve('offline query',max_generated_tokens=1)
    assert result.cost_ledger.generated_tokens<=1, result

@pytest.mark.parametrize('event',['cancel','deadline'])
def test_final_strategy_cannot_report_completed_after_stop_event(event):
    stopped=False
    def stop():
        nonlocal stopped
        stopped=True
        if event=='deadline':
            time.sleep(0.03)
    backend=Backend(stop)
    _,_,_,controller=make(backend)
    result=controller.solve('offline query',is_cancelled=lambda:stopped if event=='cancel' else False,
                            deadline_monotonic=time.monotonic()+0.01 if event=='deadline' else None)
    assert result.status==('cancelled' if event=='cancel' else 'timeout'),result

def test_cancel_hook_reaches_backend_run():
    _,_,backend,controller=make()
    controller.solve('offline query',is_cancelled=lambda:False)
    assert backend.cancel_hook_received, 'Controller called backend.run(strategy, query) without a cancellation callback'

class PartialFailureBackend(Backend):
    def run(self,strategy,query):
        self.calls.append(strategy.name)
        self.last_trace={'generations':[{'status':'success','completion_tokens':20},
                                        {'status':'success','completion_tokens':20},
                                        {'status':'failed','completion_tokens':0}]}
        raise RuntimeError('fixture failure after three dispatches')

def test_backend_error_preserves_attempt_ledger_for_caller():
    _,_,_,controller=make(PartialFailureBackend())
    with pytest.raises(RuntimeError) as caught:
        controller.solve('offline query')
    ledger=getattr(caught.value,'cost_ledger',None)
    assert ledger is not None, 'Exception discarded the local attempt counters'
    assert ledger.underlying_requests_dispatched==3
    assert ledger.generated_tokens==40

def test_worker_error_preserves_attempt_ledger():
    bundle,policy,backend,_=make(PartialFailureBackend())
    engine=build_composed_meta_reasoner(bundle,backend,policy,allow_synthetic=True)
    result,_=worker_result(OnlineReasoningWorker(engine,'offline query'))
    assert result.cost_ledger is not None, result
    assert result.cost_ledger['underlying_requests_dispatched']==3

@pytest.mark.parametrize('changes',[
    {'model_id':'incompatible','model_snapshot':'incompatible','prompt_profile':'unsupported'},
    {'backend_protocol':'NonexistentProtocol.v999'},
    {'feature_schema_version':999},
    {'source_hashes':{},'artifact_hashes':{},'dataset_versions':{},'train_calibration_provenance':{}},
    {'calibrator_type':'unknown-calibrator'},
    {'lambda_val':float('nan')},
    {'stopping_thresholds':(float('nan'),float('nan'))},
],ids=['identity','protocol','feature-version','empty-provenance','calibrator','nan-lambda','nan-thresholds'])
def test_incompatible_approved_metadata_fails_closed(changes):
    bundle,policy,backend,_=make()
    approved=replace(bundle,review_status='approved',is_production_approved=True,**changes)
    with pytest.raises(BundleValidationError):
        validate_policy_bundle(approved,policy,backend)

def test_feature_dimension_mismatch_rejected_before_embedding():
    bundle,policy,backend,_=make()
    # The specimen's fitted regressors expect 2 embedding + 3 complexity features.
    invalid=replace(bundle,feature_schema_version=2)
    with pytest.raises(BundleValidationError):
        build_composed_meta_reasoner(invalid,backend,policy,allow_synthetic=True)

def test_worker_document_change_during_execution_is_unresolved(tmp_path):
    document=tmp_path/'document.txt'
    document.write_text('version one')
    backend=Backend(lambda:document.write_text('version two'))
    bundle,policy,_,_=make(backend)
    engine=build_composed_meta_reasoner(bundle,backend,policy,allow_synthetic=True)
    result,_=worker_result(OnlineReasoningWorker(engine,'question about document',document_path=str(document)))
    assert result.status=='unresolved', {'result':result,'document':document.read_text()}

def test_worker_forwards_observed_step_progress():
    bundle,policy,backend,_=make()
    engine=build_composed_meta_reasoner(bundle,backend,policy,allow_synthetic=True)
    result,steps=worker_result(OnlineReasoningWorker(engine,'offline query'))
    assert steps, {'status':result.status,'steps':steps}
