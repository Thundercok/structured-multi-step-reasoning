+    valid, errors = validate_context_snapshot(snap)
+    assert valid, errors
+
+    note_ent = next(e for e in snap["entities"] if e["ref"]["kind"] == "note_version")
+    assert is_value_ref(note_ent["body"]["quote"])
+    ptr = note_ent["body"]["quote"]["$value_ref"]["pointer"]
