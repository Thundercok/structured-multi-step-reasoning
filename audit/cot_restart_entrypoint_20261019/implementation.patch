+def test_resume_fingerprint_tracks_canonical_reasoning_behind_root_shims(tmp_path, monkeypatch):
+    output = tmp_path / "canonical"
+    dataset, settings = fresh.synthetic_dataset(), fresh.MockSettings(64, 64)
+    manifest = fresh.run_mock(dataset, output, settings)
+    target = "reasoning/reasoning_strategies.py"
+    hashes = manifest["identity"]["source_sha256"]
+    assert hashes[target] == fresh.file_digest(fresh.ROOT / target)
+    before = (output / "manifest.json").read_bytes()
+    original = fresh.file_digest
+
+    def changed_canonical(path):
+        return "0" * 64 if Path(path) == fresh.ROOT / target else original(path)
+
+    monkeypatch.setattr(fresh, "file_digest", changed_canonical)
+    with pytest.raises(ValueError, match="identity mismatch"):
+        fresh.run_mock(dataset, output, settings)
+    assert (output / "manifest.json").read_bytes() == before
