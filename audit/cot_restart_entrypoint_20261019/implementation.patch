+def test_supported_entrypoint_and_compatibility_command_share_exact_resume(tmp_path, capsys):
+    from experiments.research_study import main
+    from scripts.smoke_cot_restart_fresh import main as compatibility_main
+
+    output = tmp_path / "entrypoint"
+    main(["--cot-restart-fresh-smoke", "--output", str(output)])
+    result = json.loads(capsys.readouterr().out)
+    assert result["completed_mock_calls"] == 12 and result["real_model_calls"] == 0
+    before = {p.name: p.read_bytes() for p in output.iterdir() if p.is_file()}
+    compatibility_main(["--output", str(output)])
+    assert json.loads(capsys.readouterr().out) == result
+    assert before == {p.name: p.read_bytes() for p in output.iterdir() if p.is_file()}
+
