+                    background: transparent;
+                    border: none;
+                    font-size: 12px;
+                    gridline-color: {tokens.line_hex};
+                    color: {tokens.ink_hex};
+                    selection-background-color: {tokens.soft_hex};
+                    selection-color: {tokens.accent_hex};
+                }}
+                QHeaderView::section {{
+                    background: {tokens.soft_hex};
