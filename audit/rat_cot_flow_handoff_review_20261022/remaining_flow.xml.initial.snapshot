            cal.a=0.;cal.b=-20.
            policy.calibrators.append(cal)
        data['calibrators']=[{'type':'platt','a':c.a,'b':c.b,'is_fitted':c.is_fitted} for c in policy.calibrators]
        artifact.write_text(json.dumps(data))
