"""Approved calibration binding and request-context transport; no inference."""
from dataclasses import asdict,replace
import hashlib,importlib.util,json,sys
from pathlib import Path
from types import SimpleNamespace
from unittest.mock import Mock
import numpy as np
import pytest
from PyQt6.QtTest import QSignalSpy
from PyQt6.QtWidgets import QApplication
from reasoning.bundle import BundleValidationError,create_synthetic_specimen_bundle,validate_policy_bundle
from reasoning.optimal_stopping import PlattCalibrator
from rat.engine.assistant_runtime import AgentResponse
from rat.engine.execution import ExecutionRequest,execution_response
from rat.engine.meta_reasoner import build_composed_meta_reasoner
from rat.ui.assistant_worker import create_execution_worker

sys.dont_write_bytecode=True
ROOT=Path(__file__).resolve().parents[2];HERE=Path(__file__).resolve().parent
spec=importlib.util.spec_from_file_location('flow_review_helpers',ROOT/'audit/rat_cot_runtime_codex_review_r3_20261020/test_boundary_contracts.py')
helper=importlib.util.module_from_spec(spec);spec.loader.exec_module(helper);helper.HERE=HERE
def save(name,data):
    (HERE/name).write_text(json.dumps(data,indent=2)+'\n')

def test_calibrated_approved_policy_binds_finite_calibrator_parameters(tmp_path):
    bundle,policy,backend,artifact=helper.approved_fixture(tmp_path)
    data=json.loads(artifact.read_text())
    data['entry_perf_models']=[{'constant':model.value} for model in policy.entry_predictor.perf]
    policy.calibrators=[]
    for _ in policy.tau:
        cal=PlattCalibrator().fit(np.array([0.,.2,.8,1.]),np.array([0,0,1,1]))
        cal.a=0.;cal.b=-20.
        policy.calibrators.append(cal)
    data['calibrators']=[{'type':'platt','a':c.a,'b':c.b,'is_fitted':c.is_fitted} for c in policy.calibrators]
    artifact.write_text(json.dumps(data))
    bundle=replace(bundle,calibrator_type='platt',calibrator_semantics='platt_probability',artifact_hashes={str(artifact):hashlib.sha256(artifact.read_bytes()).hexdigest()})
    try:
        original=validate_policy_bundle(bundle,policy,backend)
    except BundleValidationError as error:
        # A validator may reject an unsupported calibration artifact/schema.
        save('calibrator_parameter_binding.json',{'safe_initial_rejection':str(error)})
        return
    before=policy.should_escalate(0,0.)
    policy.calibrators[0].b=20.
    try:
        changed=validate_policy_bundle(bundle,policy,backend)
    except BundleValidationError as error:
        outcome={'accepted':False,'error':str(error)}
    else:
        outcome={'accepted':True,'report':asdict(changed)}
    save('calibrator_parameter_binding.json',{'original_report':asdict(original),'mutation_result':outcome,'artifact':artifact.read_text(),'artifact_sha256':hashlib.sha256(artifact.read_bytes()).hexdigest(),'declared_sha256':bundle.artifact_hashes[str(artifact)],'live_calibrators':[vars(c) for c in policy.calibrators],'should_escalate_at_zero_before':before,'should_escalate_at_zero_after':policy.should_escalate(0,0.)})
    assert not outcome['accepted'],outcome

@pytest.fixture(scope='module')
def app():
    return QApplication.instance() or QApplication([])

def execute_request(app,request):
    class Backend:
        hidden_size=2
        def __init__(self):self.inputs=[]
        def embed(self,query):return np.zeros(2)
        def run(self,strategy,query,**kwargs):
            self.inputs.append(query)
            return 'authored synthetic response',.99,2
    backend=Backend();bundle,policy=create_synthetic_specimen_bundle()
    engine=build_composed_meta_reasoner(bundle,backend,policy,allow_synthetic=True)
    runtime=SimpleNamespace(run=Mock(return_value=AgentResponse('fallback',[],0,0,0)),db=SimpleNamespace(_local=SimpleNamespace(conn=None)))
    worker=create_execution_worker(runtime,request,reasoning_engine=engine,allow_synthetic_policy=True)
    spy=QSignalSpy(worker.response_ready);worker.start()
    assert spy.wait(5000) and worker.wait(5000)
    app.processEvents()
    response=execution_response(request,spy[0][0])
    return backend,response,runtime

def test_reasoning_followup_receives_referenced_context(app):
    query='Sao phải dùng mid + 1?'
    marker='AUTHORED_CONTEXT_ARRAY=[2,4,6,8,10]; target=8'
    request=ExecutionRequest(query,'exec-followup',3,SimpleNamespace(turn_id='turn-3'),lane='reasoning',context={'history':[{'role':'user','content':marker,'turn_id':'turn-2'}],'task_state':{'topic':'binary search','array':[2,4,6,8,10],'target':8},'turn_references':[{'turn_id':'turn-2'}]})
    backend,response,runtime=execute_request(app,request)
    save('reasoning_context_transport.json',{'display_query':request.query,'supplied_context':request.context,'observed_backend_inputs':backend.inputs,'response_execution_id':response.execution_id,'response_turn_id':response.turn_id,'cost_ledger':response.qa_telemetry.get('cost_ledger'),'fallback_called':runtime.run.called})
    assert request.query==query and response.turn_id=='turn-3'
    assert backend.inputs and any(marker in item for item in backend.inputs)

def test_control_plain_request_preserves_identity(app):
    request=ExecutionRequest('authored standalone query','exec-plain',1,SimpleNamespace(turn_id='turn-1'),lane='reasoning')
    backend,response,runtime=execute_request(app,request)
    assert response.answer=='authored synthetic response'
    assert response.execution_id=='exec-plain' and response.turn_id=='turn-1'
    assert backend.inputs==[request.query] and not runtime.run.called
    assert response.answer_verification_status=='UNKNOWN'

def test_control_approved_uncalibrated_full_artifact_validates(tmp_path):
    bundle,policy,backend,artifact=helper.approved_fixture(tmp_path)
    data=json.loads(artifact.read_text());data['entry_perf_models']=[{'constant':m.value} for m in policy.entry_predictor.perf]
    artifact.write_text(json.dumps(data))
    bundle=replace(bundle,artifact_hashes={str(artifact):hashlib.sha256(artifact.read_bytes()).hexdigest()})
    assert validate_policy_bundle(bundle,policy,backend).is_valid
